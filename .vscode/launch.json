{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Uvicorn: 本项目",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "justMyCode": true
        },
        {
            "name": "Pytest: test_health",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_health.py", "-v", "-s"],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
            "justMyCode": true
        }
    ]
}
